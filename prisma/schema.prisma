generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatutEdition {
  EN_COURS
  ABANDONNEE
  EN_PAUSE
  VENDUE
}

enum TypeLienSerie {
  PREQUELLE
  SUITE
  SERIE_MERE
  HORS_SERIE
  SPIN_OFF
  GUIDE
  AUTRE
}

enum RoleUtilisateur {
  PROPRIETAIRE
  UTILISATEUR
}

model Utilisateur {
  id             String          @id @default(uuid())
  email          String?         @unique
  nom            String?
  role           RoleUtilisateur @default(UTILISATEUR)
  aPaye          Boolean         @default(false)
  creeLe         DateTime        @default(now())
  suivis         SuiviEdition[]
  possessions    Possession[]
  editionsCreees Edition[]       @relation("editionsCreees")
}

model Serie {
  id            String      @id @default(uuid())
  slug          String      @unique
  titre         String
  titreVo       String?
  auteur        String
  genres        String[]
  themes        String[]
  alias         String[]    @default([])
  cible         String?
  couvertureUrl String?
  editions      Edition[]
  liens         LienSerie[] @relation("liensSortants")
  liensEntrants LienSerie[] @relation("liensEntrants")

  @@index([titre])
  @@index([alias(ops: ArrayOps)], type: Gin)
}

model LienSerie {
  id          String        @id @default(uuid())
  serie       Serie         @relation("liensSortants", fields: [serieId], references: [id], onDelete: Cascade)
  serieId     String
  serieLiee   Serie         @relation("liensEntrants", fields: [serieLieeId], references: [id], onDelete: Cascade)
  serieLieeId String
  type        TypeLienSerie

  @@unique([serieId, serieLieeId])
  @@index([serieId])
}

model Edition {
  id                 String         @id @default(uuid())
  serie              Serie          @relation(fields: [serieId], references: [id], onDelete: Cascade)
  serieId            String
  slug               String         @unique
  nom                String
  editeur            String?
  tomesParus         Int
  editionTerminee    Boolean?
  prixDefautCentimes Int?
  slugMangaNews      String?
  couvertureUrl      String?
  creeePar           Utilisateur?   @relation("editionsCreees", fields: [creeeParId], references: [id], onDelete: SetNull)
  creeeParId         String?
  volumes            Volume[]
  sorties            Sortie[]
  suivis             SuiviEdition[]

  @@index([serieId])
}

model SuiviEdition {
  id            String        @id @default(uuid())
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  edition       Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId     String
  statut        StatutEdition
  suivie        Boolean       @default(true)
  ajouteeLe     DateTime      @default(now())

  @@unique([utilisateurId, editionId])
  @@index([utilisateurId])
  @@index([utilisateurId, suivie])
}

model Sortie {
  id            String   @id @default(uuid())
  edition       Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId     String
  numero        Int
  date          DateTime
  isbn          String?
  couvertureUrl String?

  @@unique([editionId, numero])
  @@index([date])
}

model Volume {
  id            String       @id @default(uuid())
  edition       Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId     String
  numero        Int
  isbn          String?
  dateSortie    DateTime?
  prixCentimes  Int?
  couvertureUrl String?
  possessions   Possession[]

  @@unique([editionId, numero])
}

model Possession {
  id               String      @id @default(uuid())
  utilisateur      Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId    String
  volume           Volume      @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  volumeId         String
  possede          Boolean     @default(false)
  dateAchat        DateTime?
  prixPayeCentimes Int?
  etat             String?
  lu               Boolean     @default(false)
  note             Int?

  @@unique([utilisateurId, volumeId])
  @@index([utilisateurId, possede])
}

model ParutionCatalogue {
  id              String   @id @default(uuid())
  ean             String?
  titreBrut       String
  serieTitre      String
  serieNormalise  String
  marqueurEdition String?
  numero          Int?
  editeur         String?
  date            DateTime

  @@unique([titreBrut, date])
  @@index([ean])
  @@index([serieNormalise])
}
