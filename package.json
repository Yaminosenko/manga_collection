{
  "name": "manga-collection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "covers:fetch": "python scripts/fetch_covers.py",
    "covers:upload": "tsx scripts/upload-covers.ts",
    "covers:manuelles": "python scripts/import_covers_manuelles.py",
    "anilist:fetch": "tsx scripts/fetch-anilist.ts",
    "anilist:apply": "tsx scripts/apply-anilist.ts",
    "publication:fetch": "python scripts/fetch_publication.py",
    "publication:apply": "tsx scripts/apply-publication.ts",
    "planning:import": "python scripts/import_planning.py",
    "planning:apply": "tsx scripts/apply-planning.ts",
    "publishers:fetch": "python scripts/fetch_publishers.py",
    "publishers:apply": "tsx scripts/apply-publishers.ts",
    "relations:fetch": "tsx scripts/fetch-relations.ts",
    "relations:apply": "tsx scripts/apply-relations.ts",
    "titles:fetch": "python scripts/fetch_titles.py",
    "titles:apply": "tsx scripts/apply-titles.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
