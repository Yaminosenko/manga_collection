# Neon > Connection Details. Region eu-central-1 (Frankfurt).
# DATABASE_URL : la chaine POOLEE, son hote contient "-pooler".
# DIRECT_URL   : la chaine DIRECTE, meme hote sans "-pooler". Sert aux migrations Prisma.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2. Sert a envoyer les couvertures depuis le poste local
# (npm run covers:upload, npm run covers:migrate). L'APPLICATION N'EN A PAS BESOIN :
# elle ne fait que lire les URL absolues stockees en base, donc rien de tout ceci
# n'est a renseigner dans Vercel.
#
# R2_ENDPOINT          l'endpoint S3 affiche a la creation du jeton, recopie tel quel.
#                      Ne pas le reconstruire depuis l'identifiant de compte : un bucket
#                      cree sous une jurisdiction porte un endpoint different
#                      (…​.eu.r2.cloudflarestorage.com), et la difference est invisible
#                      jusqu'a l'echec.
# R2_ACCESS_KEY_ID     R2 > Manage API tokens > Create token, portee Object Read & Write
# R2_SECRET_ACCESS_KEY le meme ecran, affiche une seule fois
# R2_BUCKET            le nom du bucket
# R2_PUBLIC_BASE       la base publique du bucket, sans barre finale. Au 3 septembre 2026
#                      c'est l'URL r2.dev, le temps qu'un domaine personnalise existe :
#                      bucket > Settings > Public access > R2.dev subdomain > Allow Access.
#                      Cloudflare la reserve au developpement, la limite en debit et NE LA
#                      MET PAS EN CACHE. Y basculer un domaine plus tard est gratuit :
#                      les objets ne bougent pas, covers:migrate se contente de reecrire
#                      les URL puisqu'il ne trouve rien a envoyer.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE=""

# Le mot de passe unique qui ouvre l'application. Le plan Hobby ne sait pas proteger
# le domaine de production (All Deployments est reserve aux plans Pro), la garde est
# donc dans l'application. Sans cette variable, tout est refuse.
ACCESS_PASSWORD=""

# Facultative. Renseignee, elle detourne scripts/backup-db.ts vers un Postgres local
# au lieu de Neon : c'est ainsi qu'on exerce une restauration destructive sans toucher
# a la vraie collection. Lever la base par `npx prisma dev -d -n manga`.
# LOCAL_DATABASE_URL=""

# Facultative. Dossier des CSV de planning manga-news, qui ne sont pas versionnes.
# Sinon, passer le dossier en argument : npm run planning:import <dossier>
# PLANNING_DIR=""
